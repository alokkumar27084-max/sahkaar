PORT=5000
# Postgres connection string: postgres://user:pass@host:port/dbname
DATABASE_URL=postgresql://user:password@host:port/dbname
DB_SSL=true
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
MSG91_API_KEY=your_msg91_api_key_here
MSG91_USE_FLOW_API=true
MSG91_FLOW_ID=your_msg91_flow_id_here
MSG91_OTP_VAR=OTP
MSG91_SENDER_ID=THEKED
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Use Razorpay Dashboard test keys in development; never commit live keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Optional: Admin account seeded at startup if none exists
# Provide credentials so an administrator can log in
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password_here

