# ─────────────────────────────────────────────
# THEKEDAAR FRONTEND — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# NEVER commit .env to Git
# ─────────────────────────────────────────────

# Your backend API URL
# Must match backend PORT (default 5000): http://localhost:5000/api
REACT_APP_API_URL=http://localhost:5000/api

# Google Maps API key (for map display only — restrict to your domain in Google Console)
REACT_APP_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# App name (used in title tags)
REACT_APP_NAME=Thekedaar

# Environment: development | production
REACT_APP_ENV=development

# Optional: GA4 Measurement ID (e.g. G-XXXXXXXXXX)
REACT_APP_GA4_ID=
