# ─────────────────────────────────────────────
# THEKEDAAR FRONTEND — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# NEVER commit .env to Git
# ─────────────────────────────────────────────

# Your backend API URL
# Must match backend PORT (default 5000): http://localhost:5000/api
REACT_APP_API_URL=http://localhost:5000/api

# Google Maps API key (for map display only — restrict to your domain in Google Console)
REACT_APP_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# Google Sign-In client ID (Web application OAuth client)
REACT_APP_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Firebase client config (required for phone OTP and email-link auth)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id_here
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
REACT_APP_FIREBASE_APP_ID=your_firebase_app_id_here
REACT_APP_FIREBASE_MEASUREMENT_ID=

# App name (used in title tags)
REACT_APP_NAME=SahKaar

# Environment: development | production
REACT_APP_ENV=development

# Optional: GA4 Measurement ID (e.g. G-XXXXXXXXXX)
REACT_APP_GA4_ID=
